# Proxy URL — set only if auto-detection doesn't work
# Auto-detection: app.config.ts reads os.networkInterfaces() at build time,
# so most of the time you don't need this at all.
#
# Override examples:
#   Android emulator on Linux: http://10.0.2.2:8787
#   Specific device / different network: http://192.168.x.x:8787
# EXPO_PUBLIC_PROXY_URL=http://10.0.2.2:8787

# Optional: EAS project ID after `eas init`
# EAS_PROJECT_ID=
