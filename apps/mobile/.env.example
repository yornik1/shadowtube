# Proxy URL override.
# Default APK/dev config uses the deployed AWS proxy:
#   http://ec2-16-16-146-238.eu-north-1.compute.amazonaws.com:8788
#
# Override examples:
#   Local Android emulator: http://10.0.2.2:8787
#   Local physical device / same Wi‑Fi: http://192.168.x.x:8787
# EXPO_PUBLIC_PROXY_URL=http://10.0.2.2:8787

# Opt into app.config.ts LAN auto-detection for local proxy dev.
# SHADOWTUBE_USE_LOCAL_PROXY=1

# EAS project ID after `eas init` (@yornik/shadowtube)
# EAS_PROJECT_ID=c472fd1e-fa2b-4ca3-a74d-da0eb6baf131

# For local-proxy APK builds — baked in at compile time (phone + Mac on same Wi‑Fi, pnpm proxy:dev):
# EXPO_PUBLIC_PROXY_URL=http://192.168.x.x:8787
